{
  "format": "lab-protocol-draft",
  "format_version": "0.1",
  "status": "draft",
  "synthetic": true,
  "protocol_id": "full-feature-check",
  "protocol_version": "1",
  "title": "全功能实测（虚构）",
  "description": "纯虚构流程，仅用于软件验收：覆盖确认建立起点、手动起点、步骤计划时间、多字段采样、跳过步骤。时间很短以便实测。",
  "time_unit": "seconds",
  "run_start_anchor_id": "run_start",
  "anchors": [
    { "id": "run_start", "label": "实验开始", "create_on": { "event": "run_started" } },
    { "id": "heat", "label": "开始加热", "create_on": { "event": "step_confirmed", "step_id": "heat_on" } },
    { "id": "ppt", "label": "沉淀出现", "create_on": { "event": "manual" } }
  ],
  "steps": [
    { "id": "prep", "title": "准备", "instruction": "模拟：准备器材。", "completion": "manual_confirmation" },
    { "id": "heat_on", "title": "开始加热", "instruction": "模拟：打开加热，确认后建立“开始加热”起点。", "completion": "manual_confirmation" },
    { "id": "hold", "title": "保温等待", "instruction": "模拟：加热 30 秒后再确认；期间按计划测温。", "completion": "manual_confirmation",
      "sampling_plan_ids": ["temp_series"], "not_before": { "anchor_id": "heat", "offset": 30 } },
    { "id": "watch_ppt", "title": "观察沉淀", "instruction": "模拟：看到沉淀时手动建立“沉淀出现”起点，然后按计划计数。", "completion": "manual_confirmation",
      "sampling_plan_ids": ["ppt_series"] },
    { "id": "rinse", "title": "可选清洗", "instruction": "模拟：可以跳过的步骤。", "completion": "manual_confirmation" },
    { "id": "finish", "title": "结束整理", "instruction": "模拟：核对采样后结束。", "completion": "manual_confirmation" }
  ],
  "sampling_plans": [
    { "id": "temp_series", "label": "温度", "anchor_id": "heat", "offsets": [15, 30, 45], "capture_mode": "manual",
      "fields": [ { "id": "temp", "label": "温度", "type": "decimal", "unit": "℃" }, { "id": "color", "label": "颜色", "type": "text" } ] },
    { "id": "ppt_series", "label": "沉淀计数", "anchor_id": "ppt", "offsets": [20, 40], "capture_mode": "manual",
      "fields": [ { "id": "count", "label": "颗粒数", "type": "integer", "unit": "个" } ] }
  ],
  "free_observations": { "enabled": true, "step_association": "optional", "advances_step": false }
}
